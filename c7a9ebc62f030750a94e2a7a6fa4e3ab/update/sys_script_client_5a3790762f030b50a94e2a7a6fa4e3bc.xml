<?xml version="1.0" encoding="UTF-8"?><record_update sys_domain="global" table="sys_script_client">
    <sys_script_client action="INSERT_OR_UPDATE">
        <active>true</active>
        <applies_extended>false</applies_extended>
        <condition/>
        <description>Auto fill 'Assigned Group' based on Type of Asset</description>
        <field>type_of_asset</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Auto Fill 'Assigned Group'</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var assetType = g_form.getValue('type_of_asset');

   var gaGroup = new GlideAjax('assetRequestAjaxUtils');

   gaGroup.addParam('sysparm_name', 'getAssignmentGroup');
   gaGroup.addParam('sysparm_asset_type', assetType);

   gaGroup.getXMLAnswer(function(response) {
	g_form.setValue('assignment_group', response);
   });
   
}]]></script>
