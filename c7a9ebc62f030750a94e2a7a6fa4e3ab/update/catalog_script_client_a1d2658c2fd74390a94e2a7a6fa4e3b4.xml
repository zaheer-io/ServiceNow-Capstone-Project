        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading || newValue == '') {
        return;
    }


	// Set Assignment group based on Asset Type

	var gaGroup = new GlideAjax('assetRequestAjaxUtils');

	var assetType = g_form.getValue('type_of_asset');

	gaGroup.addParam('sysparm_name', 'getAssignmentGroup');
	gaGroup.addParam('sysparm_asset_type', assetType);

	gaGroup.getXMLAnswer(function(response) {
		g_form.setValue('assignment_group', response);
	});

}]]></script>
